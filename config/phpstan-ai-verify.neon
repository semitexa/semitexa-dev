## Focused PHPStan configuration used by `bin/semitexa ai:verify`.
##
## - level 0 — PHPStan's default level-0 checks (class/method/constant
##   existence, basic argument arity, etc.) are ACTIVE. They are the
##   project's first line of defence against broken-FQCN time-bombs
##   introduced by vendor renames, and are how the `phpstan_di` target
##   catches the bug class addressed by `ep-ai-verify-broken-fqcn-guard`.
##   The project's own `phpstan.neon` runs the same checks at level=max
##   over a different (narrower) path set; the two are complementary.
## - Loads the Semitexa-owned DI rules on top of those defaults so
##   ai:verify is the AI-facing shim around the same source of truth,
##   not a parallel ruleset.
## - No baseline is included: ai:verify must surface every DI / FQCN
##   violation on the changed file so an AI agent gets immediate,
##   actionable feedback.
## - Identifiers (`semitexa.injectionViaConstructor`,
##   `semitexa.staticContainerAccess`, `class.notFound`,
##   `staticMethod.notFound`, …) flow through to the NDJSON `violation`
##   events verbatim.

parameters:
    level: 0
    reportUnmatchedIgnoredErrors: false

    # Single source of truth for the autoloader — re-uses the project's
    # vendor/autoload.php so PHPStan can reflect Semitexa attributes. The
    # semitexa-core bootstrap registers PSR-4 for local modules
    # (src/modules/<Name>/src), since runtime registration via the
    # LocalModuleAutoloadPhase build phase never runs under PHPStan.
    bootstrapFiles:
        - %currentWorkingDirectory%/vendor/autoload.php
        - %currentWorkingDirectory%/vendor/semitexa/core/bootstrap/phpstan.php

    # Mirror the main `phpstan.neon` excludePaths for files that can only
    # be analysed against the host's composer install, never inside the
    # framework autoloader (e.g. the composer plugin pulls in
    # composer/composer which lives only on the host).
    #
    # Also exclude `semitexa-ultimate/src` — ultimate is a `type: project`
    # consumer skeleton (the target of `composer create-project
    # semitexa/ultimate`), not a library required by semitexa.dev. It is
    # actively maintained, but it's circular to `require` a project
    # skeleton from the dev environment that produces it. ai:verify in
    # semitexa.dev gates framework + library code; ultimate is gated by
    # its own release-readiness workflow.
    # Packages that live in this monorepo but are NOT installed in the dev
    # workspace. Their classes are absent from vendor/composer/autoload_psr4.php,
    # so PHPStan reported every reference to them as semitexa.brokenFqcn — a
    # package's own classes, on disk, next to the file referencing them.
    #
    # MEASURED 2026-09-06: semitexa/demo, showcase-kit, theme-sky and ultimate
    # are absent from installed.json. semitexa/demo additionally has a STALE
    # vendor/semitexa/demo symlink left from April, so it looks installed to
    # anything that checks the filesystem while the autoloader knows nothing
    # about it — which is why the failure read as a broken FQCN rather than a
    # missing package.
    #
    # scanDirectories, not autoload: these are analysed as symbols so references
    # resolve, without installing 327 files of routes and handlers into the dev
    # runtime and changing what discovery finds.
    scanDirectories:
        - %currentWorkingDirectory%/packages/semitexa-demo/src
        - %currentWorkingDirectory%/packages/semitexa-showcase-kit/src
        - %currentWorkingDirectory%/packages/semitexa-theme-sky/src

    excludePaths:
        - %currentWorkingDirectory%/packages/semitexa-core/src/Composer/SemitexaPlugin.php
        - %currentWorkingDirectory%/packages/semitexa-ultimate/src

    ignoreErrors:
        # PHPStan's own runtime-reflection diagnostic fires from inside
        # our custom PHPStan rules when they use is_subclass_of() against
        # a runtime class. The rules deliberately use runtime reflection
        # because they reflect Semitexa attribute classes loaded via the
        # project autoloader. Not a class-resolution concern — ignore
        # just inside the rules directory.
        -
            identifier: phpstanApi.runtimeReflection
            path: %currentWorkingDirectory%/packages/semitexa-core/src/PHPStan/Rules/*

rules:
    - Semitexa\Core\PHPStan\Rules\InjectionViaConstructorRule
    - Semitexa\Core\PHPStan\Rules\StaticContainerAccessRule
    # Ships in semitexa/core (semitexa-core#108). The packages travel in
    # lockstep everywhere this config runs (path repos in the workbench and
    # release clone; consumer installs get exact pins via semitexa/ultimate),
    # but when merging develop→master, land the core PR before this one.
    - Semitexa\Core\PHPStan\Rules\StaticFacadeAccessRule
    - Semitexa\Core\PHPStan\Rules\InjectedPropertyVisibilityRule
    - Semitexa\Core\PHPStan\Rules\InjectOnScalarTypeRule
    - Semitexa\Core\PHPStan\Rules\ConfigOnArrayTypeRule
    - Semitexa\Core\PHPStan\Rules\ConfigOnClassTypeRule
    - Semitexa\Core\PHPStan\Rules\UnannotatedServicePropertyRule
    - Semitexa\Core\PHPStan\Rules\TraitInjectionRule
    - Semitexa\Core\PHPStan\Rules\WorkerServiceConnectionHandleRule
    - Semitexa\Core\PHPStan\Rules\NoOpMapperRule
    - Semitexa\Core\PHPStan\Rules\DomainModelEncapsulationRule
